# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Foundation Models (Server-Side Only)
# Do NOT prefix with NEXT_PUBLIC_ to prevent leaking keys to the client browser
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Search Engine Results / SERP Provider (Optional / Server-Side)
SERP_API_KEY=your_serp_provider_api_key_here

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_ANALYTICS_ID=
